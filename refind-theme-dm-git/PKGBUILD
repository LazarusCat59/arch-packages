pkgname=refind-theme-dm-git
pkgver=r14.41bcf08
pkgrel=1
pkgdesc="dm. A theme for rEFInd."
arch=('any')
url="https://github.com/mustaqimM/dm"
license=('none')
depends=('refind')
makedepends=('git')
source=("${pkgname}::git+https://github.com/mustaqimM/dm.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    mkdir -p "${pkgdir}/boot/EFI/refind/themes/dm"
    cp -r "${srcdir}/${pkgname}"/* "${pkgdir}/boot/EFI/refind/themes/dm/"

    echo 'Remember to add "include themes/dm/theme.conf" to your refind.conf file'
}
